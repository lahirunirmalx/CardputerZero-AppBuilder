#!/bin/sh
set -e
# The app opens /dev/spidev* and /dev/gpiochip*; grant the pi user the
# relevant groups so it can talk to the radio without root. (input/video
# kept for parity with the other framebuffer/SDL demos.)
for grp in spi gpio input video; do
    if getent group "$grp" >/dev/null && id -u pi >/dev/null 2>&1; then
        usermod -aG "$grp" pi || true
    fi
done
exit 0
