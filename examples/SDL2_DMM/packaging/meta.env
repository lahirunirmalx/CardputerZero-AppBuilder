PKG_NAME=sdl2-dmm
PKG_VERSION=0.1
PKG_REVISION=m5stack1
PKG_DESC="Bench multimeter (Open LabBench) for CardputerZero: demo + real DMMs over USB-TMC / GPIB"
PKG_DEPENDS="libsdl2-2.0-0, libsdl2-ttf-2.0-0, libusb-1.0-0, libwayland-client0, fonts-dejavu-core"
APP_NAME="Multimeter"
APP_EXEC=/usr/share/APPLaunch/bin/sdl2-dmm
APP_TERMINAL=false
APP_ICON=share/images/sdl2-dmm.png
